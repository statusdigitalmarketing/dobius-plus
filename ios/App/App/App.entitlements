<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications capability (docs/native-push.md). Xcode signs App Store and TestFlight builds with
	     "production" automatically; a build run from Xcode stays on the development (sandbox) host. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
